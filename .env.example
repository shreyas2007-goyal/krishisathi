# KisanSAATHI Environment Configuration Template
# Copy this file to .env and fill in your actual secrets (never commit .env to Git).

# Backend AI & Voice Server
PORT=3001
OPENAI_API_KEY=your_openai_api_key_here

# Frontend Expo Public Endpoints
EXPO_PUBLIC_VOICE_SERVER_URL=http://localhost:3001

# Web3 / EVM Network Configuration (Polygon Amoy Testnet)
EXPO_PUBLIC_WEB3_CHAIN_ID=0x13882
EXPO_PUBLIC_WEB3_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
